---
interface Props {
  title: string;
  emoji?: string;
  open?: boolean;
}
const { title, emoji, open = false } = Astro.props;
---

<details class="collapsible" open={open || undefined}>
  <summary class="collapsible-summary">
    {emoji && <span class="collapsible-emoji">{emoji}</span>}
    <span class="collapsible-title">{title}</span>
    <span class="collapsible-arrow">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M6 9l6 6 6-6"/>
      </svg>
    </span>
  </summary>
  <div class="collapsible-body">
    <slot>
      <p class="empty-placeholder">Próximamente...</p>
    </slot>
  </div>
</details>

<style>
  .collapsible {
    background: var(--color-white);
    border: 1px solid var(--color-gray-200);
    border-radius: var(--radius-md);
    overflow: hidden;
    margin-bottom: 0.625rem;
    box-shadow: var(--shadow-sm);
  }

  .collapsible-summary {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.875rem 1rem;
    cursor: pointer;
    user-select: none;
    list-style: none;
    -webkit-tap-highlight-color: transparent;
    transition: background 0.15s;
    min-height: 52px;
  }

  .collapsible-summary::-webkit-details-marker {
    display: none;
  }

  .collapsible-summary:active {
    background: var(--color-gray-100);
  }

  .collapsible-emoji {
    font-size: 1.125rem;
    flex-shrink: 0;
    line-height: 1;
  }

  .collapsible-title {
    flex: 1;
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--color-navy);
  }

  .collapsible-arrow {
    color: var(--color-teal);
    transition: transform 0.2s ease;
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  details[open] .collapsible-arrow {
    transform: rotate(180deg);
  }

  .collapsible-body {
    padding: 0.25rem 1rem 1rem;
    border-top: 1px solid var(--color-gray-100);
    font-size: 0.9rem;
    color: var(--color-gray-600);
    line-height: 1.6;
  }

  .empty-placeholder {
    color: var(--color-gray-600);
    font-style: italic;
    font-size: 0.875rem;
    padding: 0.5rem 0;
  }

  /* When open, summary gets a subtle background */
  details[open] > .collapsible-summary {
    background: var(--color-gray-50);
  }
</style>
