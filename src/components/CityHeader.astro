---
interface Props {
  city: string;
  country: string;
  flag: string;
  date: string;
  arrival: string;
  departure: string;
  note?: string;
  gradient: string;
}
const { city, country, flag, date, arrival, departure, note, gradient } = Astro.props;
---

<div class="city-header" style={`background: ${gradient}`}>
  <div class="city-top">
    <div class="city-identity">
      <span class="city-flag">{flag}</span>
      <h1 class="city-name">{city}</h1>
    </div>
    <div class="city-times">
      <span class="time-val">{arrival}</span>
      <span class="time-arrow">→</span>
      <span class="time-val">{departure}</span>
    </div>
  </div>
  <div class="city-meta">
    <span class="city-country">{country}</span>
    <span class="meta-sep">·</span>
    <span class="city-date">{date}</span>
  </div>
  {note && <div class="city-note">{note}</div>}
</div>

<style>
  .city-header {
    border-radius: var(--radius-lg);
    padding: 0.875rem 1rem;
    color: white;
    margin-bottom: 1.25rem;
    position: relative;
    overflow: hidden;
  }

  .city-header::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.15);
    pointer-events: none;
  }

  .city-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: relative;
    z-index: 1;
    margin-bottom: 0.3rem;
  }

  .city-identity {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .city-flag {
    font-size: 1.375rem;
    line-height: 1;
  }

  .city-name {
    font-size: 1.4rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    text-shadow: 0 1px 3px rgba(0,0,0,0.3);
    line-height: 1;
  }

  .city-times {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    background: rgba(255,255,255,0.22);
    backdrop-filter: blur(4px);
    border-radius: 100px;
    padding: 0.25rem 0.65rem;
  }

  .time-val {
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.01em;
  }

  .time-arrow {
    font-size: 0.75rem;
    opacity: 0.7;
  }

  .city-meta {
    font-size: 0.75rem;
    opacity: 0.85;
    position: relative;
    z-index: 1;
    display: flex;
    gap: 0.3rem;
    flex-wrap: wrap;
  }

  .meta-sep {
    opacity: 0.5;
  }

  .city-note {
    margin-top: 0.4rem;
    background: rgba(255,255,255,0.18);
    border-radius: var(--radius-sm);
    padding: 0.3rem 0.65rem;
    font-size: 0.72rem;
    position: relative;
    z-index: 1;
    opacity: 0.9;
    line-height: 1.4;
  }
</style>
