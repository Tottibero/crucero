---
interface Props {
  city: string;
  country: string;
  flag: string;
  date: string;
  arrival: string;
  departure: string;
  note?: string;
  gradient: string;
}
const { city, country, flag, date, arrival, departure, note, gradient } = Astro.props;
---

<div class="city-header" style={`background: ${gradient}`}>
  <div class="city-flag">{flag}</div>
  <h1 class="city-name">{city}</h1>
  <p class="city-country">{country}</p>

  <div class="city-times">
    <div class="time-item">
      <span class="time-label">Llegada</span>
      <span class="time-value">{arrival}</span>
    </div>
    <div class="time-divider">→</div>
    <div class="time-item">
      <span class="time-label">Salida</span>
      <span class="time-value">{departure}</span>
    </div>
  </div>

  <div class="city-date">{date}</div>

  {note && (
    <div class="city-note">
      <span>{note}</span>
    </div>
  )}
</div>

<style>
  .city-header {
    border-radius: var(--radius-lg);
    padding: 1.75rem 1.25rem 1.5rem;
    text-align: center;
    color: white;
    margin-bottom: 1.25rem;
    position: relative;
    overflow: hidden;
  }

  .city-header::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.15);
    pointer-events: none;
  }

  .city-flag {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
    position: relative;
    z-index: 1;
  }

  .city-name {
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 0.125rem;
    position: relative;
    z-index: 1;
    text-shadow: 0 1px 3px rgba(0,0,0,0.3);
  }

  .city-country {
    font-size: 0.9rem;
    opacity: 0.85;
    margin-bottom: 1rem;
    position: relative;
    z-index: 1;
  }

  .city-times {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    background: rgba(255,255,255,0.2);
    backdrop-filter: blur(4px);
    border-radius: var(--radius-sm);
    padding: 0.625rem 1.25rem;
    margin-bottom: 0.75rem;
    position: relative;
    z-index: 1;
  }

  .time-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.125rem;
  }

  .time-label {
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    opacity: 0.8;
    font-weight: 500;
  }

  .time-value {
    font-size: 1.125rem;
    font-weight: 700;
  }

  .time-divider {
    font-size: 1.25rem;
    opacity: 0.6;
    margin-top: 0.75rem;
  }

  .city-date {
    font-size: 0.8125rem;
    opacity: 0.85;
    position: relative;
    z-index: 1;
    font-weight: 500;
  }

  .city-note {
    margin-top: 0.75rem;
    background: rgba(255,255,255,0.2);
    border-radius: var(--radius-sm);
    padding: 0.5rem 0.875rem;
    font-size: 0.8rem;
    position: relative;
    z-index: 1;
  }
</style>
