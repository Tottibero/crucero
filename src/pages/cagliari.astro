---
import Layout from '../layouts/Layout.astro';
import CityHeader from '../components/CityHeader.astro';
import Collapsible from '../components/Collapsible.astro';
---

<Layout title="Cagliari" backUrl="/" backLabel="Itinerario">
  <CityHeader
    city="Cagliari"
    country="Cerdeña, Italia"
    flag="🇮🇹"
    date="Martes 5 de mayo · Día 3"
    arrival="07:00"
    departure="16:00"
    note="9 horas en puerto · Puerto: Porto di Cagliari"
    gradient="linear-gradient(135deg, #2d6a4f 0%, #1b4332 100%)"
  />

  <Collapsible title="Itinerario del día" emoji="📅">
    <div class="timeline">

      <div class="tl-step">
        <div class="tl-time">07:00</div>
        <div class="tl-dot tl-dot--anchor"></div>
        <div class="tl-body">
          <div class="tl-title">⚓ Desembarco en el puerto</div>
          <div class="tl-desc">Puerto de Cagliari, terminal de cruceros.</div>
        </div>
      </div>

      <div class="tl-transit">
        <div class="tl-transit-line"></div>
        <div class="tl-transit-label">
          🚌 Shuttle gratuito Terminal → Via Roma · 10 min · Gratis
          <a class="tl-maps" href="https://maps.google.com/maps/dir/Terminal+Crociere+Cagliari/Via+Roma,+Cagliari" target="_blank">📍 Ruta</a>
        </div>
      </div>

      <div class="tl-step">
        <div class="tl-time">07:10</div>
        <div class="tl-dot tl-dot--sight"></div>
        <div class="tl-body">
          <div class="tl-title">Barrio de Marina <a class="tl-maps" href="https://maps.google.com/?q=Marina,+Cagliari" target="_blank">📍 Maps</a></div>
          <div class="tl-desc">Paseo matutino por las callejuelas, ambiente tranquilo antes de que lleguen los turistas. Tiendas de productos locales y ambiente muy auténtico.</div>
          <div class="tl-dur">~35 min</div>
        </div>
      </div>

      <div class="tl-transit">
        <div class="tl-transit-line"></div>
        <div class="tl-transit-label">
          🚶 A pie ~5 min → Piazza Yenne
          <a class="tl-maps" href="https://maps.google.com/maps/dir/Marina,+Cagliari/Piazza+Yenne,+Cagliari" target="_blank">📍 Ruta</a>
        </div>
      </div>

      <div class="tl-step">
        <div class="tl-time">07:45</div>
        <div class="tl-dot tl-dot--food"></div>
        <div class="tl-body">
          <div class="tl-title">☕ Desayuno en Piazza Yenne <a class="tl-maps" href="https://maps.google.com/?q=Piazza+Yenne,+Cagliari" target="_blank">📍 Maps</a></div>
          <div class="tl-desc">Café con leche y brioche sardo o "pardula" (pastelito de queso fresco). Las terrazas abren desde las 7:00. Plaza animada con heladerías y bares.</div>
          <div class="tl-dur">~30 min</div>
        </div>
      </div>

      <div class="tl-transit">
        <div class="tl-transit-line"></div>
        <div class="tl-transit-label">
          🚶 A pie ~2 min · Ascensor desde Piazza Yenne → Castello (gratis)
          <a class="tl-maps" href="https://maps.google.com/maps/dir/Piazza+Yenne,+Cagliari/Bastione+di+Saint+Remy,+Cagliari" target="_blank">📍 Ruta</a>
        </div>
      </div>

      <div class="tl-step">
        <div class="tl-time">08:20</div>
        <div class="tl-dot tl-dot--sight"></div>
        <div class="tl-body">
          <div class="tl-title">Bastione di Saint Remy + Castello <a class="tl-maps" href="https://maps.google.com/?q=Bastione+di+Saint+Remy,+Cagliari" target="_blank">📍 Maps</a></div>
          <div class="tl-desc">La mejor terraza de Cagliari. Vistas panorámicas sobre el golfo y la ciudad. Desde aquí entra en el Barrio de Castello: calles medievales empedradas y la Catedral de Santa María (entrada gratuita).</div>
          <div class="tl-dur">~1h 40min</div>
        </div>
      </div>

      <div class="tl-transit">
        <div class="tl-transit-line"></div>
        <div class="tl-transit-label">
          🚶 A pie ~5 min → punto de encuentro Free Tour (frente al Bastione)
        </div>
      </div>

      <div class="tl-step">
        <div class="tl-time">10:00</div>
        <div class="tl-dot tl-dot--tour"></div>
        <div class="tl-body">
          <div class="tl-title">🎙️ Free Tour Cagliari <a class="tl-maps" href="https://maps.google.com/?q=Bastione+di+Saint+Remy,+Cagliari" target="_blank">📍 Maps</a></div>
          <div class="tl-desc">2 horas por el distrito histórico de Castello con guía local. Historia, comida y curiosidades. Punto de encuentro: frente al Bastione di Saint Remy. Reserva en freetourscagliari.com.</div>
          <div class="tl-tags">
            <span class="tl-tag-price">Adultos 11€ · Niños 6€</span>
            <span class="tl-tag">10:00 – 12:00</span>
          </div>
        </div>
      </div>

      <div class="tl-transit">
        <div class="tl-transit-line"></div>
        <div class="tl-transit-label">
          🚶 A pie ~8 min → Barrio de Marina
          <a class="tl-maps" href="https://maps.google.com/maps/dir/Bastione+di+Saint+Remy,+Cagliari/Su+Cumbidu,+Cagliari" target="_blank">📍 Ruta</a>
        </div>
      </div>

      <div class="tl-step">
        <div class="tl-time">12:15</div>
        <div class="tl-dot tl-dot--food"></div>
        <div class="tl-body">
          <div class="tl-title">🍽️ Comida en Su Cumbidu <a class="tl-maps" href="https://maps.google.com/?q=Su+Cumbidu,+Cagliari" target="_blank">📍 Maps</a></div>
          <div class="tl-desc">Cocina sarda auténtica en el Barrio de Marina. Pide los malloreddus al ragú sardo o fregola con arselle (pasta con almejas). Reserva recomendada.</div>
          <div class="tl-tags">
            <span class="tl-tag-price">~20–30€/persona</span>
            <span class="tl-tag">Barrio Marina</span>
          </div>
          <div class="tl-dur">~1h 15min</div>
        </div>
      </div>

      <div class="tl-transit">
        <div class="tl-transit-line"></div>
        <div class="tl-transit-label">
          🚶 A pie ~5 min → Piazza Matteotti · Bus PF dirección Poetto
          <a class="tl-maps" href="https://maps.google.com/maps/dir/Piazza+Matteotti,+Cagliari/Spiaggia+del+Poetto,+Cagliari" target="_blank">📍 Ruta en bus</a>
        </div>
      </div>

      <div class="tl-step">
        <div class="tl-time">13:30</div>
        <div class="tl-dot tl-dot--transport"></div>
        <div class="tl-body">
          <div class="tl-title">🚌 Bus PF → Playa de Poetto</div>
          <div class="tl-desc">Sale desde Piazza Matteotti. Billete en estancos o app CTM antes de subir. El bus para justo en la orilla de la playa.</div>
          <div class="tl-tags">
            <span class="tl-tag-price">~1,30€/trayecto</span>
            <span class="tl-tag">~20 min</span>
          </div>
        </div>
      </div>

      <div class="tl-step">
        <div class="tl-time">13:50</div>
        <div class="tl-dot tl-dot--beach"></div>
        <div class="tl-body">
          <div class="tl-title">🏖️ Playa de Poetto <a class="tl-maps" href="https://maps.google.com/?q=Spiaggia+del+Poetto,+Cagliari" target="_blank">📍 Maps</a></div>
          <div class="tl-desc">8 km de arena blanca y agua turquesa. Si el tiempo acompaña, baño rápido. A 5 min andando por la orilla está el Parque de Molentargius — en mayo se ven flamencos rosados en los estanques.</div>
          <div class="tl-dur">~1h 20min</div>
        </div>
      </div>

      <div class="tl-transit">
        <div class="tl-transit-line"></div>
        <div class="tl-transit-label">
          🚌 Bus PF de vuelta → Piazza Matteotti · ~20 min · ~1,30€
          <a class="tl-maps" href="https://maps.google.com/maps/dir/Spiaggia+del+Poetto,+Cagliari/Piazza+Matteotti,+Cagliari" target="_blank">📍 Ruta</a>
        </div>
      </div>

      <div class="tl-step">
        <div class="tl-time">15:10</div>
        <div class="tl-dot tl-dot--transport"></div>
        <div class="tl-body">
          <div class="tl-title">🚶 Regreso al puerto</div>
          <div class="tl-desc">Desde Via Roma el shuttle gratuito de la terminal o 10 min a pie hasta el barco. Llegas con 50 minutos de margen antes de la salida.</div>
        </div>
      </div>

      <div class="tl-step tl-step--last">
        <div class="tl-time">15:30</div>
        <div class="tl-dot tl-dot--end"></div>
        <div class="tl-body">
          <div class="tl-title">✅ A bordo — salida 16:00</div>
        </div>
      </div>

    </div>
    <div class="tip-box">
      <strong>Tip:</strong> Si no te apetece la playa, usa esa última hora para comprar bottarga, mirto o pecorino en el Mercado de San Benedetto, el más grande de Cerdeña.
      <a class="tl-maps" href="https://maps.google.com/?q=Mercato+di+San+Benedetto,+Cagliari" target="_blank" style="margin-left:0.25rem">📍 Maps</a>
    </div>
  </Collapsible>

  <Collapsible title="Planes generales" emoji="🗺️">
    <div class="plan-list">
      <div class="plan-item">
        <div class="plan-name">Barrio de Castello <a class="maps-link" href="https://maps.google.com/?q=Castello,+Cagliari" target="_blank">📍 Maps</a></div>
        <div class="plan-desc">El casco histórico medieval en lo alto de la ciudad. Calles empedradas, murallas medievales y vistas panorámicas espectaculares. Acceso a pie subiendo por Via Manno o en ascensor desde Piazza Yenne.</div>
      </div>
      <div class="plan-item">
        <div class="plan-name">Bastione di Saint Remy <a class="maps-link" href="https://maps.google.com/?q=Bastione+di+Saint+Remy,+Cagliari" target="_blank">📍 Maps</a></div>
        <div class="plan-desc">Terraza mirador del siglo XIX con las mejores vistas de Cagliari y el golfo. Hay cafeterías debajo de las arcadas. Imprescindible para la foto.</div>
      </div>
      <div class="plan-item">
        <div class="plan-name">Catedral de Santa María <a class="maps-link" href="https://maps.google.com/?q=Cattedrale+di+Santa+Maria,+Cagliari" target="_blank">📍 Maps</a></div>
        <div class="plan-desc">Construida en el siglo XIII, mezcla de estilos pisano, barroco y neorrománico. Entrada gratuita. Está en la Piazza Palazzo, en el corazón de Castello.</div>
      </div>
      <div class="plan-item">
        <div class="plan-name">Torre dell'Elefante <a class="maps-link" href="https://maps.google.com/?q=Torre+dell%27Elefante,+Cagliari" target="_blank">📍 Maps</a></div>
        <div class="plan-desc">Una de las dos torres medievales que quedan en pie (siglo XIV). Se puede subir para tener vistas sobre los tejados del barrio.</div>
        <div class="plan-tags">
          <span class="tag-price">~3€ entrada</span>
        </div>
      </div>
      <div class="plan-item">
        <div class="plan-name">Anfiteatro Romano <a class="maps-link" href="https://maps.google.com/?q=Anfiteatro+Romano,+Cagliari" target="_blank">📍 Maps</a></div>
        <div class="plan-desc">Uno de los mejor conservados de Italia. Excavado en la roca viva, data del siglo II d.C. Está a 10 min a pie del puerto, en el barrio de Villanova.</div>
        <div class="plan-tags">
          <span class="tag-price">~3€ entrada</span>
        </div>
      </div>
      <div class="plan-item">
        <div class="plan-name">Playa de Poetto <a class="maps-link" href="https://maps.google.com/?q=Spiaggia+del+Poetto,+Cagliari" target="_blank">📍 Maps</a></div>
        <div class="plan-desc">8 km de arena blanca y aguas turquesas a 10 min en autobús del centro. Perfecta si el día acompaña. Hay chiringuitos y alquiler de tumbonas. Bus PF desde Piazza Matteotti.</div>
      </div>
      <div class="plan-item">
        <div class="plan-name">Barrio de Marina <a class="maps-link" href="https://maps.google.com/?q=Marina,+Cagliari" target="_blank">📍 Maps</a></div>
        <div class="plan-desc">El barrio más animado, justo al lado del puerto. Lleno de callejuelas con restaurantes, heladerías y tiendas de productos locales. Ideal para pasear y comer.</div>
      </div>
    </div>
  </Collapsible>

  <Collapsible title="Planes con niños" emoji="👨‍👩‍👧">
    <div class="plan-list">
      <div class="plan-item">
        <div class="plan-name">Parque de Molentargius <a class="maps-link" href="https://maps.google.com/?q=Parco+Naturale+Regionale+Molentargius,+Cagliari" target="_blank">📍 Maps</a></div>
        <div class="plan-desc">Parque natural justo detrás de Poetto. En mayo se pueden ver flamencos rosados en los estanques. Entrada gratuita, hay carriles para caminar. Combinable con la playa.</div>
      </div>
      <div class="plan-item">
        <div class="plan-name">Museo Arqueológico Nacional <a class="maps-link" href="https://maps.google.com/?q=Museo+Archeologico+Nazionale,+Cagliari" target="_blank">📍 Maps</a></div>
        <div class="plan-desc">Alberga los famosos Gigantes de Monte Prama, estatuas nurágicas únicas en el mundo. A los niños les suelen encantar. En la Ciudadela de los Museos.</div>
        <div class="plan-tags">
          <span class="tag-price">~5€ entrada</span>
        </div>
      </div>
      <div class="plan-item">
        <div class="plan-name">Heladería en Piazza Yenne <a class="maps-link" href="https://maps.google.com/?q=Piazza+Yenne,+Cagliari" target="_blank">📍 Maps</a></div>
        <div class="plan-desc">La plaza principal está llena de heladerías. El gelato sardo es cremoso y con sabores locales como mirto o pistacchio. Un clásico para reponer fuerzas.</div>
      </div>
    </div>
  </Collapsible>

  <Collapsible title="Free tours" emoji="🚶">
    <div class="plan-list">
      <div class="plan-item">
        <div class="plan-name">Free Tours Cagliari</div>
        <div class="plan-desc">Recorrido a pie de 2 horas por el distrito histórico de Castello: historia, cultura, comida y curiosidades de la ciudad.</div>
        <div class="plan-tags">
          <span class="tag">10:00 AM</span>
          <span class="tag">2 horas</span>
          <span class="tag">Mayores de 10 años</span>
          <span class="tag-price">Adultos (18+): 11€</span>
          <span class="tag-price">Niños (5–17): 6€</span>
        </div>
        <a href="https://www.freetourscagliari.com" class="plan-link" target="_blank">freetourscagliari.com →</a>
      </div>
    </div>
    <div class="tip-box">
      <strong>Consejo:</strong> Con llegada a las 07:00 hay tiempo de sobra para el tour de las 10:00 y aún queda tarde libre para comer y pasear antes de volver al barco a las 16:00.
    </div>
  </Collapsible>

  <Collapsible title="Transporte desde el puerto" emoji="🚌">
    <div class="plan-list">
      <div class="plan-item">
        <div class="plan-name">Shuttle gratuito de la terminal</div>
        <div class="plan-desc">La terminal tiene un shuttle gratuito hasta Via Roma. Desde allí el centro es todo a pie.</div>
      </div>
      <div class="plan-item">
        <div class="plan-name">Bus CTM — Línea PF para Poetto</div>
        <div class="plan-desc">Sale desde Piazza Matteotti (junto al puerto). Cómpralo en los estancos o en la app CTM antes de subir.</div>
        <div class="plan-tags">
          <span class="tag-price">~1,30€/trayecto</span>
          <span class="tag">~20 min hasta Poetto</span>
        </div>
      </div>
    </div>
  </Collapsible>

  <Collapsible title="Restaurantes" emoji="🍽️">
    <div class="plan-list">
      <div class="plan-item">
        <div class="plan-name">Su Cumbidu</div>
        <div class="plan-desc">Uno de los más populares de Cagliari, en el barrio de Marina. Cocina sarda auténtica a precios razonables. Prueba los malloreddus (pasta sarda) o el cordero. Reserva recomendada.</div>
        <div class="plan-tags">
          <span class="tag">Barrio Marina</span>
          <span class="tag">Cocina sarda</span>
          <span class="tag-price">~20–30€/persona</span>
        </div>
      </div>
      <div class="plan-item">
        <div class="plan-name">Su Combidu Mare</div>
        <div class="plan-desc">La versión marinera del anterior, especializada en pescado fresco. Fritto misto, bottarga y espaguetis a las almejas. Muy buena relación calidad-precio.</div>
        <div class="plan-tags">
          <span class="tag">Especialidad pescado</span>
          <span class="tag-price">~25–35€/persona</span>
        </div>
      </div>
      <div class="plan-item">
        <div class="plan-name">Stella Marina di Montecristo</div>
        <div class="plan-desc">Restaurante con reconocimiento Michelin pero sin precios inflados. Cocina marinera sarda de alta calidad. Muy bien situado, cerca del puerto.</div>
        <div class="plan-tags">
          <span class="tag">Michelin</span>
          <span class="tag">Mariscos y pescado</span>
          <span class="tag-price">~40–60€/persona</span>
        </div>
      </div>
      <div class="plan-item">
        <div class="plan-name">Osteria Antica (Via Azuni 56)</div>
        <div class="plan-desc">Pequeña ostería en el barrio de Marina con ambiente tradicional. Menú del día asequible, buena pasta y vino local. Ambiente auténtico sin turistas.</div>
        <div class="plan-tags">
          <span class="tag">Barrio Marina</span>
          <span class="tag">Económico</span>
          <span class="tag-price">~15–20€/persona</span>
        </div>
      </div>
    </div>
    <div class="tip-box">
      <strong>Platos típicos a pedir:</strong> Malloreddus al ragú sardo, bottarga (huevas de mújol curadas), fregola con arselle (pasta con almejas), porceddu (lechón asado), seadas (postre de queso con miel).
    </div>
  </Collapsible>

  <Collapsible title="Consejos prácticos" emoji="ℹ️">
    <div class="plan-list">
      <div class="plan-item">
        <div class="plan-name">Horario de vuelta al barco</div>
        <div class="plan-desc">La salida es a las 16:00. Se recomienda estar de vuelta en el puerto antes de las 15:30. El shuttle de vuelta desde Via Roma funciona hasta poco antes de la salida.</div>
      </div>
      <div class="plan-item">
        <div class="plan-name">Qué comprar</div>
        <div class="plan-desc">Bottarga (huevas de mújol), mirto (licor de mirto), queso pecorino sardo, cerámica de Assemini, joyas de coral. El mercado de San Benedetto es el más grande de Cerdeña.</div>
      </div>
    </div>
  </Collapsible>
</Layout>

<style>
  .plan-list {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    padding-top: 0.5rem;
  }

  .plan-item {
    border-left: 3px solid var(--color-teal-light);
    padding-left: 0.875rem;
  }

  .plan-name {
    font-weight: 700;
    font-size: 0.9375rem;
    color: var(--color-navy);
    margin-bottom: 0.25rem;
  }

  .plan-desc {
    font-size: 0.875rem;
    color: var(--color-gray-600);
    line-height: 1.55;
  }

  .plan-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: 0.375rem;
  }

  .tag {
    background: var(--color-gray-100);
    color: var(--color-gray-600);
    font-size: 0.75rem;
    font-weight: 500;
    padding: 0.125rem 0.5rem;
    border-radius: 100px;
  }

  .tag-price {
    background: #ecfdf5;
    color: #065f46;
    border: 1px solid #6ee7b7;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.125rem 0.5rem;
    border-radius: 100px;
  }

  .plan-link {
    display: inline-block;
    margin-top: 0.375rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-teal);
    text-decoration: underline;
  }

  .tip-box {
    background: var(--color-sand);
    border-radius: var(--radius-sm);
    padding: 0.75rem 1rem;
    font-size: 0.875rem;
    color: var(--color-gray-800);
    margin-top: 0.875rem;
    line-height: 1.55;
  }

  .tip-box strong {
    color: var(--color-navy);
  }

  /* ── Timeline ── */
  .timeline {
    padding-top: 0.25rem;
  }

  .tl-step {
    display: grid;
    grid-template-columns: 3rem 0.75rem 1fr;
    gap: 0 0.5rem;
    align-items: start;
    padding-bottom: 0;
  }

  .tl-step--last {
    padding-bottom: 0;
  }

  .tl-time {
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--color-navy);
    padding-top: 0.15rem;
    text-align: right;
    line-height: 1.2;
  }

  .tl-dot {
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    margin-top: 0.175rem;
    flex-shrink: 0;
    position: relative;
    z-index: 1;
  }

  .tl-dot--anchor  { background: #94a3b8; border: 2px solid #64748b; }
  .tl-dot--sight   { background: #0891b2; border: 2px solid #0e7490; }
  .tl-dot--food    { background: #f59e0b; border: 2px solid #d97706; }
  .tl-dot--tour    { background: #8b5cf6; border: 2px solid #7c3aed; }
  .tl-dot--transport { background: #94a3b8; border: 2px solid #64748b; }
  .tl-dot--beach   { background: #06b6d4; border: 2px solid #0891b2; }
  .tl-dot--end     { background: #22c55e; border: 2px solid #16a34a; }

  .tl-body {
    padding-bottom: 0.25rem;
  }

  .tl-title {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-navy);
    line-height: 1.3;
  }

  .tl-desc {
    font-size: 0.8rem;
    color: var(--color-gray-600);
    line-height: 1.5;
    margin-top: 0.15rem;
  }

  .tl-dur {
    font-size: 0.7rem;
    color: var(--color-gray-600);
    font-style: italic;
    margin-top: 0.2rem;
  }

  .tl-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin-top: 0.3rem;
  }

  .tl-tag {
    background: var(--color-gray-100);
    color: var(--color-gray-600);
    font-size: 0.7rem;
    font-weight: 500;
